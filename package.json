{
  "name": "figario",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.30",
      "typescript": "^7.0.2",
      "drizzle-orm": "^0.45.4",
      "drizzle-kit": "^0.31.11",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "bun --filter @figario/api dev",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U figario -d figario"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "catalog:"
  }
}
