{
  "name": "@figario/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --bun --env-file=../../.env drizzle-kit migrate",
    "db:studio": "bun --bun --env-file=../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@figario/shared": "workspace:*",
    "elysia": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
